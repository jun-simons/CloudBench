# Public hostname(s) of the VM; Caddy gets a TLS certificate for each automatically.
# Separate several with ", ", e.g. "cloudbench.work, 104-238-131-98.sslip.io".
# Each one's DNS must already point at the VM.
CLOUDBENCH_DOMAIN=cloudbench.example.com

# JSON map of workbench ID to agent secret. Generate with: openssl rand -hex 32
CLOUDBENCH_AGENT_SECRETS={"wb_faraday": "change-me"}

# Bearer token for /admin endpoints (maintenance mode, revoking leases).
CLOUDBENCH_ADMIN_TOKEN=change-me

CLOUDBENCH_LEASE_MAX_DURATION_S=180
